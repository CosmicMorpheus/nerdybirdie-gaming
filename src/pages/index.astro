---
import Base from '../layouts/Base.astro';
import CozmcPanel from '../components/CozmcPanel.astro';
import Hud from '../islands/Hud';
import { getGame, getPlatform, publicGuides, publicObjectives } from '../lib/content/load';
import { SITE_NAME, TAGLINE } from '../config';

const game = getGame('gta-vi');
const objectives = publicObjectives(game.id);
const guides = publicGuides(game.id);
const platforms = game.platforms.map((gp) => {
  const p = getPlatform(gp.platformId);
  return { id: p.id, shortLabel: p.shortLabel, objectiveNoun: p.objectiveNoun, objectiveIds: objectives.filter((o) => o.platformIds.includes(p.id)).map((o) => o.id) };
});
const trackerHref = `/games/${game.id}/achievements/`;
const guidesHref = `/games/${game.id}/guides/`;
const quests = game.guideCategories.map((c) => ({ ...c, count: guides.filter((g) => g.category === c.id).length }));
---
<Base title={SITE_NAME} description={`${TAGLINE} Free, spoiler-safe GTA VI achievement tracking and guide checklists, built for checking on your phone while you play.`}>
  <section class="hero">
    <div class="sky" aria-hidden="true"><div class="sun"></div><div class="grid"></div></div>
    <div class="wrap hero-inner">
      <p class="eyebrow">Now playing · Featured game</p>
      <h1>{game.title}</h1>
      <p class="promise">{game.summary}</p>
      <ul class="platforms" aria-label="Platforms">
        {game.platforms.map((p) => <li class="chip">{getPlatform(p.platformId).shortLabel}</li>)}
      </ul>
      <div class="cta">
        <a class="btn btn-primary" href={trackerHref}>▶ Press start</a>
        <a class="btn btn-ghost" href={guidesHref}>Quest board</a>
      </div>
    </div>
  </section>

  <section class="wrap block two">
    <div class="panel">
      <h2 class="sr-only">Your progress</h2>
      <Hud client:load gameId={game.id} platforms={platforms} guideStepIds={guides.flatMap((g) => g.steps.map((s) => s.id))} trackerHref={trackerHref} guidesHref={guidesHref} />
    </div>
    <div class="how panel">
      <h2>How to 100% it</h2>
      <ol>
        <li><span class="pixel">1</span><div><strong>Pick your platform</strong><br /><span class="muted small">Xbox and PS5 lists are tracked separately.</span></div></li>
        <li><span class="pixel">2</span><div><strong>Tick off as you play</strong><br /><span class="muted small">Missable items show up first in "Next up".</span></div></li>
        <li><span class="pixel">3</span><div><strong>Clear the quest board</strong><br /><span class="muted small">Every guide is a checklist. Clear them all.</span></div></li>
        <li><span class="pixel">4</span><div><strong>Rank up</strong><br /><span class="muted small">Checkpoints at 25, 50, 75 and 100%.</span></div></li>
      </ol>
      <p class="small muted">Spoiler-free by default. Saved on this device, no sign-up. <a href="/progress/">Back up your save</a>.</p>
    </div>
  </section>

  <section class="wrap block">
    <div class="head-row"><h2>Quest board</h2><a href={guidesHref}>All guides →</a></div>
    <ul class="quests">
      {quests.map((q) => (
        <li class={q.count ? '' : 'soon'}>
          <a href={guidesHref}>
            <span class="q-title">{q.label}</span>
            <span class="small muted">{q.blurb}</span>
            <span class="badge-px">{q.count ? `${q.count} guide${q.count > 1 ? 's' : ''}` : 'Coming soon'}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap block"><CozmcPanel /></section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; min-height: 540px; display: flex; align-items: flex-end; border-bottom: 2px solid #000; }
  .sky { position: absolute; inset: 0; background: linear-gradient(180deg, #120c26 0%, #3d1a45 42%, #b04d78 64%, #f39a72 78%, #0b101b 78.2%); }
  .sun { position: absolute; left: 68%; top: 16%; width: min(380px, 52vw); aspect-ratio: 1; transform: translateX(-50%); border-radius: 50%;
    background: linear-gradient(180deg, #ffe08a 0%, #ffaa76 45%, #ed6ba6 100%);
    -webkit-mask: repeating-linear-gradient(180deg, #000 0 14px, transparent 14px 18px), linear-gradient(#000 0 52%, transparent 52%);
    -webkit-mask-composite: source-over;
    mask: linear-gradient(#000 0 52%, transparent 52%), repeating-linear-gradient(180deg, #000 0 10px, transparent 10px 15px);
    mask-composite: add; opacity: 0.92; }
  .grid { position: absolute; left: -50%; right: -50%; bottom: 0; height: 22%; transform-origin: top; transform: perspective(220px) rotateX(58deg);
    background-image: linear-gradient(90deg, rgba(92, 225, 230, 0.55) 1px, transparent 1px), linear-gradient(0deg, rgba(237, 107, 166, 0.55) 1px, transparent 1px);
    background-size: 48px 48px; }
  .hero::after { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(90deg, rgba(11, 16, 27, 0.92) 0%, rgba(11, 16, 27, 0.55) 45%, transparent 75%),
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.16) 0 1px, transparent 1px 3px); }
  .hero-inner { position: relative; z-index: 1; width: 100%; padding-top: 72px; padding-bottom: 60px; }
  h1 { max-width: 12ch; font-size: clamp(40px, 7vw, 84px); text-shadow: 4px 4px 0 #000; }
  .promise { font-size: 19px; color: #ecE9F1; max-width: 52ch; margin: 0 0 18px; text-shadow: 0 1px 2px #000; }
  .platforms { list-style: none; display: flex; gap: 8px; flex-wrap: wrap; padding: 0; margin: 0 0 26px; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .block { padding-top: 48px; }
  .two { display: grid; grid-template-columns: 1.15fr 1fr; gap: 22px; align-items: start; }
  .how h2 { font-size: 24px; }
  .how ol { list-style: none; padding: 0; margin: 14px 0; display: flex; flex-direction: column; gap: 14px; }
  .how li { display: grid; grid-template-columns: 36px 1fr; gap: 12px; align-items: start; }
  .how .pixel { display: grid; place-items: center; width: 32px; height: 32px; background: var(--vc-pink); color: #1a0d16; border: 2px solid #000; box-shadow: 2px 2px 0 #000; font-size: 12px; }
  .head-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .head-row a { color: var(--vc-sunset); font-weight: 600; text-decoration: none; }
  .quests { list-style: none; padding: 0; margin: 14px 0 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: 12px; }
  .quests a { display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 14px; border: 2px solid var(--vc-line); border-radius: 6px; background: var(--vc-slate);
    text-decoration: none; box-shadow: var(--shadow-px); }
  .quests a:hover { border-color: var(--vc-pink); transform: translate(-1px, -1px); }
  .quests .soon a { background: transparent; border-style: dashed; box-shadow: none; }
  .q-title { font: 700 19px/1.2 'Space Grotesk', var(--body); }
  .quests .badge-px { margin-top: auto; align-self: flex-start; }
  @media (max-width: 1100px) { .quests { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 960px) { .two { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .hero { min-height: 520px; }
    .sun { left: 72%; top: 10%; }
    .hero::after { background: linear-gradient(180deg, rgba(11, 16, 27, 0.15) 0%, rgba(11, 16, 27, 0.85) 60%), repeating-linear-gradient(0deg, rgba(0,0,0,.16) 0 1px, transparent 1px 3px); }
    .promise { font-size: 17px; }
    .cta .btn { flex: 1; }
    .quests { grid-template-columns: 1fr 1fr; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .grid { animation: drive 3s linear infinite; }
    @keyframes drive { to { background-position: 0 48px; } }
  }
</style>
