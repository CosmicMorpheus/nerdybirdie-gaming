---
import Base from '../layouts/Base.astro';
import CozmcPanel from '../components/CozmcPanel.astro';
import GameCard from '../components/GameCard.astro';
import Hud from '../islands/Hud';
import ContinueButton from '../islands/ContinueButton';
import { featuredGames, games, getPlatform, mapData, primaryGame, publicEntries, publicObjectives, recentUpdates, trackablePinIds } from '../lib/content/load';
import { COZMC, SITE_NAME, TAGLINE } from '../config';

// The product landing page: what Nerdy Birdie Gaming Guides is, which guides exist, what changed, and your progress.
// Game-specific tools (quest board, how-to-100%) live on each game's own page (/games/<id>/).
const featured = featuredGames();
const game = primaryGame();
const objectives = publicObjectives(game.id);
const entries = publicEntries(game.id);
const platforms = game.platforms.map((gp) => {
  const p = getPlatform(gp.platformId);
  return { id: p.id, shortLabel: p.shortLabel, objectiveNoun: p.objectiveNoun, objectiveIds: objectives.filter((o) => o.platformIds.includes(p.id)).map((o) => o.id) };
});
const recent = recentUpdates(4);
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'short', timeZone: 'UTC' });
const moreCount = games.length - featured.length;
---
<Base title={SITE_NAME} description={`${TAGLINE} Free, spoiler-safe game guides: walkthroughs, maps, checklists and achievement trackers, starting with ${game.title}.`}>
  <section class="hero">
    <div class="sky" aria-hidden="true"><div class="sun"></div><div class="grid"></div></div>
    <div class="wrap hero-inner">
      <p class="eyebrow">Free, unofficial game guides · No account required</p>
      <h1>Get more out of the games you love</h1>
      <p class="promise">Spoiler-safe walkthroughs, maps, checklists and trackers you can check on your phone mid-session. Built with gamers, not just for them.</p>
      <div class="cta">
        <a class="btn btn-primary" href="/games/">▶ Explore Game Guides</a>
        <a class="btn btn-ghost" href="/progress/">My progress</a>
      </div>
      <div class="resume-row"><ContinueButton client:load /></div>
    </div>
  </section>

  <section class="wrap block" aria-labelledby="featured-h">
    <div class="head-row"><h2 id="featured-h">Featured guides</h2><a href="/games/">All game guides →</a></div>
    <ul class="featured">
      {featured.map((g) => <li><GameCard game={g} headingLevel="h3" quickLinks /></li>)}
      <li class="next">
        <p class="next-title">More guides on the way</p>
        <p class="small muted">{moreCount > 0 ? `${moreCount} more in the library. ` : ''}{game.shortTitle} is our first guide. We're growing the library with the community, one game at a time.</p>
        <p class="small"><a href="/games/">Browse the library</a>{COZMC.discord && <> · <a href={COZMC.discord} target="_blank" rel="noopener">Suggest a game<span class="sr-only"> in the COZMC Discord (opens in a new tab)</span></a></>}</p>
      </li>
    </ul>
  </section>

  <section class="wrap block two">
    <div class="panel">
      <h2 class="panel-h">Your progress <span class="muted">· {game.shortTitle}</span></h2>
      <Hud client:load gameId={game.id} platforms={platforms} guideEntryIds={entries.map((e) => e.id)} trackerHref={`/games/${game.id}/achievements/`}
        guidesHref={`/games/${game.id}/guides/`} mapTotal={trackablePinIds(game.id).length} mapHref={mapData(game.id) ? `/games/${game.id}/map/` : `/games/${game.id}/`} />
    </div>
    <div class="panel recent" aria-labelledby="recent-h">
      <div class="head-row"><h2 id="recent-h" class="panel-h">Recently updated</h2><a href="/updates/">All updates →</a></div>
      {recent.length ? (
        <ol>
          {recent.map((u) => (
            <li><time datetime={u.date}>{fmt.format(new Date(u.date + 'T12:00:00Z'))}</time>
              <span><a href={`/games/${u.game.id}/`}>{u.game.shortTitle}</a> · {u.title}</span></li>
          ))}
        </ol>
      ) : <p class="muted small">No updates yet.</p>}
    </div>
  </section>

  <section class="wrap block"><CozmcPanel /></section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; min-height: 440px; display: flex; align-items: flex-end; border-bottom: 2px solid #000; }
  /* Cosmic hero to match the Nerdy Birdie logo: starfield, purple nebula, a planet with a neon-green ring. */
  .sky { position: absolute; inset: 0; background:
      radial-gradient(ellipse at 72% 28%, rgba(139, 92, 246, 0.45), transparent 55%),
      radial-gradient(ellipse at 18% 85%, rgba(46, 230, 214, 0.16), transparent 50%),
      linear-gradient(180deg, #04061a 0%, #0b0f33 62%, #070a1c 100%); }
  .sky::before { content: ''; position: absolute; inset: 0; opacity: 0.85; background-image:
      radial-gradient(1.5px 1.5px at 12% 18%, #fff, transparent), radial-gradient(1px 1px at 28% 42%, #cfd8ff, transparent),
      radial-gradient(1.5px 1.5px at 46% 12%, #fff, transparent), radial-gradient(1px 1px at 63% 58%, #e3dcff, transparent),
      radial-gradient(1.5px 1.5px at 82% 22%, #fff, transparent), radial-gradient(1px 1px at 91% 64%, #cfd8ff, transparent),
      radial-gradient(1px 1px at 36% 70%, #fff, transparent), radial-gradient(1.5px 1.5px at 7% 60%, #e3dcff, transparent);
    background-size: 340px 260px; }
  .sun { position: absolute; left: 70%; top: 14%; width: min(360px, 50vw); aspect-ratio: 1; transform: translateX(-50%); border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #3b4fc4 0%, #18206a 45%, #0a0d2e 72%, #070a1c 100%);
    box-shadow: 0 0 70px rgba(46, 230, 214, 0.28), inset -24px -34px 70px rgba(0, 0, 0, 0.65); }
  .sun::after { content: ''; position: absolute; left: -26%; right: -26%; top: 42%; height: 26%; border-radius: 50%;
    border: 3px solid #7dff5a; transform: rotate(-14deg); box-shadow: 0 0 22px rgba(125, 255, 90, 0.7), inset 0 0 18px rgba(125, 255, 90, 0.35); }
  .grid { position: absolute; left: -50%; right: -50%; bottom: 0; height: 22%; transform-origin: top; transform: perspective(220px) rotateX(58deg);
    background-image: linear-gradient(90deg, rgba(46, 230, 214, 0.45) 1px, transparent 1px), linear-gradient(0deg, rgba(125, 255, 90, 0.4) 1px, transparent 1px);
    background-size: 48px 48px; }
  .hero::after { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(90deg, rgba(7, 10, 28, 0.92) 0%, rgba(7, 10, 28, 0.55) 45%, transparent 75%),
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.16) 0 1px, transparent 1px 3px); }
  .hero-inner { position: relative; z-index: 1; width: 100%; padding-top: 56px; padding-bottom: 48px; }
  h1 { max-width: 16ch; font-size: clamp(36px, 5.6vw, 68px); text-shadow: 4px 4px 0 #000; }
  .promise { font-size: 19px; color: #eef1ff; max-width: 52ch; margin: 0 0 18px; text-shadow: 0 1px 2px #000; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .resume-row { margin-top: 12px; }
  .resume-row :global(.continue) { min-height: 44px; font-size: 15px; }
  .block { padding-top: 40px; }
  .two { display: grid; grid-template-columns: 1.15fr 1fr; gap: 22px; align-items: start; }
  .head-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .head-row a { color: var(--vc-sunset); font-weight: 600; text-decoration: none; }
  .featured { list-style: none; padding: 0; margin: 14px 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 18px; }
  .featured:has(> li:nth-child(2):last-child) { grid-template-columns: 2fr 1fr; }
  .featured > li { container-type: inline-size; padding: 14px; border: 2px solid var(--vc-line); border-radius: 8px; background: var(--vc-slate); box-shadow: var(--shadow-px); }
  .featured .next { display: flex; flex-direction: column; justify-content: center; gap: 4px; background: transparent; border-style: dashed; box-shadow: none; }
  .next p { margin: 0; }
  .next-title { font: 700 19px/1.2 'Space Grotesk', var(--body); }
  .panel-h { font-size: 22px; margin: 0 0 12px; }
  .panel-h .muted { font-size: 16px; font-weight: 500; }
  .recent ol { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; }
  .recent li { display: grid; grid-template-columns: 64px 1fr; gap: 12px; padding: 10px 0; border-top: 1px solid var(--vc-line); }
  .recent li:first-child { border-top: 0; }
  .recent time { color: var(--vc-muted); font-size: 14px; font-variant-numeric: tabular-nums; }

  @media (max-width: 960px) { .two { grid-template-columns: 1fr; } .featured:has(> li:nth-child(2):last-child) { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .hero { min-height: 420px; }
    .hero-inner { padding-top: 40px; padding-bottom: 36px; }
    .sun { left: 72%; top: 10%; }
    .hero::after { background: linear-gradient(180deg, rgba(7, 10, 28, 0.15) 0%, rgba(7, 10, 28, 0.85) 60%), repeating-linear-gradient(0deg, rgba(0,0,0,.16) 0 1px, transparent 1px 3px); }
    .promise { font-size: 17px; }
    .cta .btn { flex: 1; padding: 0 12px; white-space: nowrap; }
    }
  @media (prefers-reduced-motion: no-preference) {
    .grid { animation: drive 3s linear infinite; }
    @keyframes drive { to { background-position: 0 48px; } }
  }
</style>
