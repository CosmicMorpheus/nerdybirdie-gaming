---
import Base from '../layouts/Base.astro';
import CozmcPanel from '../components/CozmcPanel.astro';
import Hud from '../islands/Hud';
import ContinueButton from '../islands/ContinueButton';
import { getGame, getPlatform, publicEntries, publicObjectives, trackablePinIds } from '../lib/content/load';
import { SITE_NAME, TAGLINE } from '../config';

const game = getGame('gta-vi');
const objectives = publicObjectives(game.id);
const entries = publicEntries(game.id);
const platforms = game.platforms.map((gp) => {
  const p = getPlatform(gp.platformId);
  return { id: p.id, shortLabel: p.shortLabel, objectiveNoun: p.objectiveNoun, objectiveIds: objectives.filter((o) => o.platformIds.includes(p.id)).map((o) => o.id) };
});
const trackerHref = `/games/${game.id}/achievements/`;
const hasAchievements = objectives.length > 0;
const guidesHref = `/games/${game.id}/guides/`;
const allQuests = game.guideCategories.map((c) => ({ ...c, count: entries.filter((e) => e.category === c.id).length }));
const quests = allQuests.filter((q) => q.count > 0);
const soon = allQuests.filter((q) => q.count === 0);
---
<Base title={SITE_NAME} description={`${TAGLINE} Free, spoiler-safe GTA VI achievement tracking and guide checklists, built for checking on your phone while you play.`}>
  <section class="hero">
    <div class="sky" aria-hidden="true"><div class="sun"></div><div class="grid"></div></div>
    <div class="wrap hero-inner">
      <p class="eyebrow">Free, unofficial GTA VI companion · No account required</p>
      <h1>{game.title}</h1>
      <p class="promise">{game.summary}</p>
      <ul class="platforms" aria-label="Platforms">
        {game.platforms.map((p) => <li class="chip">{getPlatform(p.platformId).shortLabel}</li>)}
      </ul>
      <div class="cta">
        {/* While no achievement list is verified, lead with what's useful today. */}
        {hasAchievements ? (
          <><a class="btn btn-primary" href={trackerHref}>▶ Start tracking</a><a class="btn btn-ghost" href={guidesHref}>Guides</a></>
        ) : (
          <><a class="btn btn-primary" href={guidesHref}>▶ Explore guides</a><a class="btn btn-ghost" href={`/games/${game.id}/map/`}>Open the map</a></>
        )}
        {hasAchievements && <a class="btn btn-ghost" href={`/games/${game.id}/map/`}>Map</a>}
      </div>
      <div class="resume-row"><ContinueButton client:load /></div>
    </div>
  </section>

  <section class="wrap block two">
    <div class="panel">
      <h2 class="sr-only">Your progress</h2>
      <Hud client:load gameId={game.id} platforms={platforms} guideEntryIds={entries.map((e) => e.id)} trackerHref={trackerHref} guidesHref={guidesHref}
        mapTotal={trackablePinIds(game.id).length} mapHref={`/games/${game.id}/map/`} />
    </div>
    <div class="how panel">
      <h2>How to 100% it</h2>
      <ol>
        <li><span class="pixel">1</span><div><strong>Pick your platform</strong><br /><span class="muted small">Xbox and PS5 lists are tracked separately.</span></div></li>
        <li><span class="pixel">2</span><div><strong>Tick off as you play</strong><br /><span class="muted small">Guide entries and map finds now; achievements once the lists are verified.</span></div></li>
        <li><span class="pixel">3</span><div><strong>Clear the quest board</strong><br /><span class="muted small">Check off tips, missions and finds in every section.</span></div></li>
        <li><span class="pixel">4</span><div><strong>Rank up</strong><br /><span class="muted small">Checkpoints at 25, 50, 75 and 100%.</span></div></li>
      </ol>
      <p class="small muted">Spoiler-free by default. Saved on this device, no sign-up. <a href="/progress/#move">Continue in another browser</a>.</p>
    </div>
  </section>

  <section class="wrap block">
    <div class="head-row"><h2>Quest board</h2><a href={guidesHref}>All guides →</a></div>
    <ul class="quests">
      {quests.map((q) => (
        <li>
          <a href={`${guidesHref}${q.id}/`}>
            <span class="q-title">{q.label}</span>
            <span class="small muted">{q.blurb}</span>
            <span class="badge-px">{`${q.count} entr${q.count > 1 ? 'ies' : 'y'}`}</span>
          </a>
        </li>
      ))}
    </ul>
    {soon.length > 0 && <p class="soon-line small muted">Coming as we verify them: {soon.map((q) => q.label).join(', ')}.</p>}
  </section>

  <section class="wrap block"><CozmcPanel /></section>
</Base>

<style>
  .hero { position: relative; overflow: hidden; min-height: 540px; display: flex; align-items: flex-end; border-bottom: 2px solid #000; }
  /* Cosmic hero to match the Nerdy Birdie logo: starfield, purple nebula, a planet with a neon-green ring. */
  .sky { position: absolute; inset: 0; background:
      radial-gradient(ellipse at 72% 28%, rgba(139, 92, 246, 0.45), transparent 55%),
      radial-gradient(ellipse at 18% 85%, rgba(46, 230, 214, 0.16), transparent 50%),
      linear-gradient(180deg, #04061a 0%, #0b0f33 62%, #070a1c 100%); }
  .sky::before { content: ''; position: absolute; inset: 0; opacity: 0.85; background-image:
      radial-gradient(1.5px 1.5px at 12% 18%, #fff, transparent), radial-gradient(1px 1px at 28% 42%, #cfd8ff, transparent),
      radial-gradient(1.5px 1.5px at 46% 12%, #fff, transparent), radial-gradient(1px 1px at 63% 58%, #e3dcff, transparent),
      radial-gradient(1.5px 1.5px at 82% 22%, #fff, transparent), radial-gradient(1px 1px at 91% 64%, #cfd8ff, transparent),
      radial-gradient(1px 1px at 36% 70%, #fff, transparent), radial-gradient(1.5px 1.5px at 7% 60%, #e3dcff, transparent);
    background-size: 340px 260px; }
  .sun { position: absolute; left: 70%; top: 14%; width: min(360px, 50vw); aspect-ratio: 1; transform: translateX(-50%); border-radius: 50%;
    background: radial-gradient(circle at 34% 30%, #3b4fc4 0%, #18206a 45%, #0a0d2e 72%, #070a1c 100%);
    box-shadow: 0 0 70px rgba(46, 230, 214, 0.28), inset -24px -34px 70px rgba(0, 0, 0, 0.65); }
  .sun::after { content: ''; position: absolute; left: -26%; right: -26%; top: 42%; height: 26%; border-radius: 50%;
    border: 3px solid #7dff5a; transform: rotate(-14deg); box-shadow: 0 0 22px rgba(125, 255, 90, 0.7), inset 0 0 18px rgba(125, 255, 90, 0.35); }
  .grid { position: absolute; left: -50%; right: -50%; bottom: 0; height: 22%; transform-origin: top; transform: perspective(220px) rotateX(58deg);
    background-image: linear-gradient(90deg, rgba(46, 230, 214, 0.45) 1px, transparent 1px), linear-gradient(0deg, rgba(125, 255, 90, 0.4) 1px, transparent 1px);
    background-size: 48px 48px; }
  .hero::after { content: ''; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(90deg, rgba(7, 10, 28, 0.92) 0%, rgba(7, 10, 28, 0.55) 45%, transparent 75%),
      repeating-linear-gradient(0deg, rgba(0, 0, 0, 0.16) 0 1px, transparent 1px 3px); }
  .hero-inner { position: relative; z-index: 1; width: 100%; padding-top: 72px; padding-bottom: 60px; }
  h1 { max-width: 12ch; font-size: clamp(40px, 7vw, 84px); text-shadow: 4px 4px 0 #000; }
  .promise { font-size: 19px; color: #eef1ff; max-width: 52ch; margin: 0 0 18px; text-shadow: 0 1px 2px #000; }
  .platforms { list-style: none; display: flex; gap: 8px; flex-wrap: wrap; padding: 0; margin: 0 0 26px; }
  .cta { display: flex; gap: 12px; flex-wrap: wrap; }
  .resume-row { margin-top: 12px; }
  .resume-row :global(.continue) { min-height: 44px; font-size: 15px; }
  .block { padding-top: 48px; }
  .two { display: grid; grid-template-columns: 1.15fr 1fr; gap: 22px; align-items: start; }
  .how h2 { font-size: 24px; }
  .how ol { list-style: none; padding: 0; margin: 14px 0; display: flex; flex-direction: column; gap: 14px; }
  .how li { display: grid; grid-template-columns: 36px 1fr; gap: 12px; align-items: start; }
  .how .pixel { display: grid; place-items: center; width: 32px; height: 32px; background: var(--vc-pink); color: #1a0d16; border: 2px solid #000; box-shadow: 2px 2px 0 #000; font-size: 12px; }
  .head-row { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; }
  .head-row a { color: var(--vc-sunset); font-weight: 600; text-decoration: none; }
  .quests { list-style: none; padding: 0; margin: 14px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 12px; }
  .soon-line { margin: 14px 0 0; }
  .quests a { display: flex; flex-direction: column; gap: 8px; height: 100%; padding: 14px; border: 2px solid var(--vc-line); border-radius: 6px; background: var(--vc-slate);
    text-decoration: none; box-shadow: var(--shadow-px); }
  .quests a:hover { border-color: var(--vc-pink); transform: translate(-1px, -1px); }
  .quests .soon a { background: transparent; border-style: dashed; box-shadow: none; }
  .q-title { font: 700 19px/1.2 'Space Grotesk', var(--body); }
  .quests .badge-px { margin-top: auto; align-self: flex-start; }

  @media (max-width: 960px) { .two { grid-template-columns: 1fr; } }
  @media (max-width: 640px) {
    .hero { min-height: 420px; }
    .hero-inner { padding-top: 40px; padding-bottom: 36px; }
    .sun { left: 72%; top: 10%; }
    .hero::after { background: linear-gradient(180deg, rgba(7, 10, 28, 0.15) 0%, rgba(7, 10, 28, 0.85) 60%), repeating-linear-gradient(0deg, rgba(0,0,0,.16) 0 1px, transparent 1px 3px); }
    .promise { font-size: 17px; }
    .cta .btn { flex: 1; padding: 0 12px; white-space: nowrap; }
    .quests { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 400px) { .quests { grid-template-columns: 1fr; } }
  @media (prefers-reduced-motion: no-preference) {
    .grid { animation: drive 3s linear infinite; }
    @keyframes drive { to { background-position: 0 48px; } }
  }
</style>
