---
import Prose from '../layouts/Prose.astro';
import Discoveries from '../islands/Discoveries';
import { creatorsFor, primaryGame, updatesFor } from '../lib/content/load';
import { DISCOVERY_FEED } from '../config';
// The creator feed follows the primary game; the history below comes from content/games/<id>/updates.json.
const game = primaryGame();
const creators = creatorsFor(game.id);
const updates = updatesFor(game.id).map((u, i) => ({ ...u, i }));
const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
---
<Prose title="Updates" current="updates" description="What's new on NerdyBirdie LLC Gaming Guides.">
  {DISCOVERY_FEED && (
    <Discoveries client:load heading="What's New from creators" sections={game.guideCategories.map((c) => ({ id: c.id, label: c.label }))}
      guidesHref={`/games/${game.id}/guides/`} />
  )}
  {DISCOVERY_FEED && creators.length > 0 && (
    <section class="creators" aria-labelledby="creators-h">
      <h2 id="creators-h">Creators we follow</h2>
      <p class="small muted">We check these YouTube channels every day for new {game.shortTitle} videos. All credit for their videos goes to them.</p>
      <ul>
        {creators.map((c) => (
          <li><a href={`https://www.youtube.com/channel/${c.channelId}`} target="_blank" rel="noopener noreferrer">{c.name}<span class="sr-only"> (YouTube channel, opens in a new tab)</span></a>
            <span class="muted"> {c.handle}</span><br /><span class="small muted">{c.focus}.</span></li>
        ))}
      </ul>
    </section>
  )}
  {updates.map((u) => (
    <section aria-labelledby={`u-${u.date}-${u.i}`}>
      <h2 id={`u-${u.date}-${u.i}`}>{fmt.format(new Date(u.date + 'T12:00:00Z'))} · {u.title}</h2>
      <ul>{u.items.map((item) => <li>{item}</li>)}</ul>
    </section>
  ))}
</Prose>
<style>
  .creators { margin: 0 0 28px; }
  .creators ul { padding-left: 1.2em; }
  .creators li { margin: 6px 0; }
</style>
