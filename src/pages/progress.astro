---
import Base from '../layouts/Base.astro';
import ProgressManager from '../islands/ProgressManager';
import { GUIDES_CONTEXT, MAP_CONTEXT } from '../lib/progress/contexts';
import { games, getPlatform, mapData, publicEntries, publicObjectives, trackablePinIds } from '../lib/content/load';
import { contextKey } from '../lib/progress/model';
const game = games[0]!;
const contexts = games.flatMap((g) => {
  const objs = publicObjectives(g.id);
  return g.platforms.map((gp) => {
    const p = getPlatform(gp.platformId);
    return { key: contextKey(g.id, p.id), label: `${g.shortTitle} · ${p.shortLabel} ${p.objectiveNoun.toLowerCase()}`, href: `/games/${g.id}/achievements/`,
      objectiveIds: objs.filter((o) => o.platformIds.includes(p.id)).map((o) => o.id) };
  });
}).concat(games.map((g) => ({ key: contextKey(g.id, GUIDES_CONTEXT), label: `${g.shortTitle} · guide entries`, href: `/games/${g.id}/guides/`, objectiveIds: publicEntries(g.id).map((e) => e.id) })))
  .concat(games.filter((g) => mapData(g.id)).map((g) => ({ key: contextKey(g.id, MAP_CONTEXT), label: `${g.shortTitle} · map finds`, href: `/games/${g.id}/map/`, objectiveIds: trackablePinIds(g.id) })));
const entries = publicEntries(game.id);
const sections = game.guideCategories.map((c) => ({ label: c.label, href: `/games/${game.id}/guides/${c.id}/`, entryIds: entries.filter((e) => e.category === c.id).map((e) => e.id) }));
---
<Base title="My progress" current="progress" description="Your saved progress, by section, with backup and restore. No sign-up needed.">
  <div class="wrap narrow">
    <h1>My progress</h1>
    <aside class="notice account" aria-labelledby="acct-h">
      <h2 id="acct-h" class="hud-label">Where your progress is saved</h2>
      <p>Saved <strong>in this browser on this device</strong>, with no account. To keep playing somewhere else, use
        <a href="#move">Continue in another browser</a> below, or download a backup file. Clearing your browser's site data erases progress that isn't backed up.</p>
    </aside>
    <ProgressManager client:load contexts={contexts} guideKey={contextKey(game.id, GUIDES_CONTEXT)} sections={sections} />
  </div>
</Base>
<style>
  h1 { padding-top: 28px; }
  .narrow { max-width: 860px; }
  .account { margin-bottom: 18px; }
  .account h2 { margin: 0 0 6px; }
  .account p { margin: 0; }
</style>
