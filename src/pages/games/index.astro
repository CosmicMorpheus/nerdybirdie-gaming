---
import Base from '../../layouts/Base.astro';
import { games, getPlatform } from '../../lib/content/load';
import GameArt from '../../components/GameArt.astro';
---
<Base title="Games" current="games" description="Games covered by NerdyBirdie LLC Gaming Guides.">
  <div class="wrap">
    <h1>Games</h1>
    <ul class="lib">
      {games.map((g) => (
        <li><a href={`/games/${g.id}/`}><GameArt gameId={g.id} /><strong>{g.title}</strong><span class="muted small">{g.platforms.map((p) => getPlatform(p.platformId).shortLabel).join(' · ')}</span></a></li>
      ))}
    </ul>
    <p class="muted">More games will be added over time.</p>
  </div>
</Base>
<style>
  h1 { padding-top: 28px; }
  .lib { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .lib a { display: flex; flex-direction: column; gap: 6px; text-decoration: none; }
  .lib a { container-type: inline-size; }
  .lib a:hover :global(.art) { border-color: var(--vc-pink); }
  strong { font: 600 18px var(--head); }
</style>
