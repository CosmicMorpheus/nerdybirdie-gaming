---
import Base from '../../layouts/Base.astro';
import GameCard from '../../components/GameCard.astro';
import { games } from '../../lib/content/load';
import { COZMC, SITE_NAME } from '../../config';
// The library lists every game in content/games/ (archived guides last). Adding a game = adding its folder; no page code changes.
const ORDER = { available: 0, preview: 1, 'coming-soon': 2, archived: 3 } as const;
const library = [...games].sort((a, b) => ORDER[a.guideStatus] - ORDER[b.guideStatus] || a.title.localeCompare(b.title));
---
<Base title="Game guides" current="games" description={`Every game guide on ${SITE_NAME}: free, spoiler-safe walkthroughs, maps, checklists and trackers.`}>
  <div class="wrap">
    <h1>Game guides</h1>
    <p class="lead muted">Pick a game to open its guide. Each guide has its own walkthroughs, checklists and trackers, and saves your progress separately.</p>
    <ul class="lib">
      {library.map((g) => <li><GameCard game={g} quickLinks /></li>)}
    </ul>
    <p class="muted">More games will be added over time. Want a guide for something you're playing? {COZMC.discord ? <>Tell us in the <a href={COZMC.discord} target="_blank" rel="noopener">COZMC Discord<span class="sr-only"> (opens in a new tab)</span></a>.</> : 'Tell us in the COZMC community.'}</p>
  </div>
</Base>
<style>
  h1 { padding-top: 28px; }
  .lead { max-width: 62ch; margin-top: 0; }
  .lib { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
</style>
