---
import Base from '../../../layouts/Base.astro';
import MapView from '../../../islands/MapView';
import { games, mapData, videosFor } from '../../../lib/content/load';
export function getStaticPaths() { return games.filter((g) => mapData(g.id)).map((g) => ({ params: { game: g.id } })); }
const game = games.find((g) => g.id === Astro.params.game)!;
const videos = videosFor(game.id).filter((v) => v.moments.some((m) => m.target.includes(':map:')));
---
<Base gameId={game.id} title={`${game.shortTitle} map of Leonida`} current="map" description={`Interactive ${game.title} map: collectibles and activities you can mark as found, with search and filters. Spoiler-safe.`}>
  <div class="wrap head">
    <div class="title-row">
      <h1>Leonida map</h1>
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/games/">Games</a> / <a href={`/games/${game.id}/`}>{game.shortTitle}</a> / <span aria-current="page">Map</span></nav>
    </div>
    <p class="muted">Tap a pin to see what it is and mark it found; finds count in the guide checklists too. Pins are community map data, marked Unconfirmed until we check them.</p>
  </div>
  <div class="wrap-wide">
    <MapView client:only="preact" gameId={game.id} dataUrl={`/data/${game.id}/map.json`} geometryUrl={`/data/${game.id}/geometry.json`} protectedUrl={`/data/${game.id}/protected.json`} videos={videos} base={`/games/${game.id}/map/`}>
      <div slot="fallback" class="map-loading" role="status">Loading the map…</div>
    </MapView>
  </div>
</Base>
<style>
  /* Compact title row so the map gets the screen (map.css sizes the map to the space left). */
  .head { padding-top: 12px; padding-bottom: 10px; }
  .title-row { display: flex; align-items: baseline; gap: 6px 18px; flex-wrap: wrap; }
  h1 { font-size: clamp(24px, 2.6vw, 32px); margin: 0; }
  .crumbs { font-size: 14px; color: var(--vc-muted); }
  .head p { margin: 4px 0 0; font-size: 14px; max-width: 110ch; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 1100px) { .head p { display: none; } }
  @media (max-width: 860px) { h1 { font-size: 24px; } .head { padding-bottom: 8px; } }
  .wrap-wide { max-width: 1600px; margin: 0 auto; padding: 0 var(--gutter); }
  @media (max-width: 860px) { .wrap-wide { padding: 0; } }
  /* Same footprint as the map, so nothing jumps when it loads. */
  .map-loading { display: grid; place-items: center; height: clamp(460px, calc(100dvh - 150px), 1400px); border: 2px solid #000; border-radius: 8px; background: var(--vc-slate); color: var(--vc-muted); }
  :global(body:has(.banner)) .map-loading { height: clamp(460px, calc(100dvh - 180px), 1400px); }
  @media (max-width: 860px) { .map-loading, :global(body:has(.banner)) .map-loading { height: calc(100dvh - 190px); min-height: 384px; border-radius: 0; border-left: 0; border-right: 0; } }
</style>
