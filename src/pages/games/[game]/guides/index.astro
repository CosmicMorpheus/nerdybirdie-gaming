---
import Base from '../../../../layouts/Base.astro';
import CozmcInline from '../../../../components/CozmcInline.astro';
import GuideBoard from '../../../../islands/GuideBoard';
import EntryBrowser from '../../../../islands/EntryBrowser';
import { games, getGame, publicEntries, videosFor } from '../../../../lib/content/load';
export function getStaticPaths() { return games.map((g) => ({ params: { game: g.id } })); }
const game = getGame(Astro.params.game!);
const entries = publicEntries(game.id);
const categories = game.guideCategories.map((c) => ({ ...c, entryIds: entries.filter((e) => e.category === c.id).map((e) => e.id) }));
---
<Base title={`${game.shortTitle} guides`} current="guides" description={`Spoiler-safe ${game.title} guide entries you can check off. Every entry lists its sources and when they were checked.`}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/games/">Games</a> / <a href={`/games/${game.id}/`}>{game.shortTitle}</a> / <span aria-current="page">Guides</span></nav>
    <p class="eyebrow">{game.shortTitle} · Quest board</p>
    <h1>Guides</h1>
    <p class="lead muted">Check off tips, missions and finds as you go. Every entry says how sure we are (Confirmed, Unconfirmed or Rumor) and links to its sources.
      Sections stay empty until we can verify something for them.</p>
    <p class="legend" aria-label="What the labels mean">
      <span><span class="tag v-ok">✓ Confirmed</span> checked against the linked source</span>
      <span><span class="tag v-warn">? Unconfirmed</span> reported, not yet independently checked (not the same as wrong)</span>
      <span><span class="tag v-bad">! Rumor</span> leak or speculation, never shown as fact</span>
      <span><span class="tag paid">Paid / optional</span> needs a purchase or subscription</span>
    </p>
    <GuideBoard client:load gameId={game.id} base={`/games/${game.id}/guides/`} categories={categories} />
    <h2 class="browse-h">All entries</h2>
    <EntryBrowser client:load gameId={game.id} categories={game.guideCategories} entries={entries} videos={videosFor(game.id)} protectedUrl={`/data/${game.id}/protected.json`} />
    <div style="margin-top:32px"><CozmcInline text="Found something? Share it in the community." /></div>
  </div>
</Base>
<style>
  .crumbs { font-size: 14px; color: var(--vc-muted); padding-top: 22px; }
  .lead { max-width: 72ch; margin: 0 0 28px; }
  .browse-h { margin: 44px 0 16px; }
</style>
