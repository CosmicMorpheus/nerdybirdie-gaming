---
import Base from '../../../../layouts/Base.astro';
import CozmcInline from '../../../../components/CozmcInline.astro';
import EntryBrowser from '../../../../islands/EntryBrowser';
import MapChecklist from '../../../../islands/MapChecklist';
import SpotChecklist from '../../../../islands/SpotChecklist';
import Discoveries from '../../../../islands/Discoveries';
import { DISCOVERY_FEED, DISCOVERY_SECTIONS } from '../../../../config';
import { games, mapData, publicEntries, videosFor } from '../../../../lib/content/load';

export function getStaticPaths() {
  return games.flatMap((game) => game.guideCategories.map((section, i) => ({
    params: { game: game.id, category: section.id },
    props: { game, section, next: game.guideCategories[i + 1] ?? null },
  })));
}
const { game, section, next } = Astro.props;
const entries = publicEntries(game.id).filter((e) => e.category === section.id);
---
<Base title={`${section.label} · ${game.shortTitle}`} current="guides" description={`${game.title}: ${section.blurb} Spoiler-safe, with sources.`}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/games/">Games</a> / <a href={`/games/${game.id}/`}>{game.shortTitle}</a> / <a href={`/games/${game.id}/guides/`}>Guides</a> / <span aria-current="page">{section.label}</span></nav>
    <p class="eyebrow">{game.shortTitle} guide</p>
    <h1>{section.label}</h1>
    <p class="lead muted">{section.blurb}</p>
    <p class="legend" aria-label="What the labels mean">
      <span><span class="tag v-ok">✓ Confirmed</span> checked against the linked source</span>
      <span><span class="tag v-warn">? Unconfirmed</span> reported, not yet independently checked (not the same as wrong)</span>
      <span><span class="tag v-bad">! Rumor</span> leak or speculation, never shown as fact</span>
      <span><span class="tag paid">Paid / optional</span> needs a purchase or subscription</span>
    </p>
    {section.id === 'collectibles' && mapData(game.id) && (
      <MapChecklist client:visible gameId={game.id} dataUrl={`/data/${game.id}/map-checklist.json`} mapHref={`/games/${game.id}/map/`} />
    )}
    {section.id === 'exploration' && mapData(game.id) && (
      <SpotChecklist client:idle gameId={game.id} dataUrl={`/data/${game.id}/exploration-spots.json`} mapHref={`/games/${game.id}/map/`}
        title="Exploration checklist" cls="explore-list" colourNote="in shades of purple like the in-game exploration icons"
        targets={{ waink: '100 of 108 scans count toward 100%', treasure: '5 Kenton sets count toward 100%', meditation: '15 of 18 count toward 100%',
          magazine: '30 count toward 100%', playlist: '2 count toward 100%', flamingo: '100 count toward 100%', underwater: '33 count toward 100%', streetart: 'Not needed for 100%' }} />
    )}
    {section.id === 'robberies' && mapData(game.id) && (
      <SpotChecklist client:idle gameId={game.id} dataUrl={`/data/${game.id}/robbery-spots.json`} mapHref={`/games/${game.id}/map/`}
        title="Robbery checklist" cls="robbery-list" colourNote="coloured like the in-game map (illegal operations yellow, smash 'n' grabs green, stick-ups light blue)"
        targets={{ gang: '39 count toward 100%', smash: '34 count toward 100%', store: '100 needed for 100%', bank: '22 bank jobs + 8 vaults', payday: '7 count toward 100%' }} />
    )}
    <EntryBrowser client:load gameId={game.id} categories={game.guideCategories} entries={entries} videos={videosFor(game.id)}
      protectedUrl={`/data/${game.id}/protected.json`} fixedCategory={section.id} />
    {DISCOVERY_FEED && DISCOVERY_SECTIONS.includes(section.id) && (
      <Discoveries client:idle heading="New creator videos for this section" category={section.id} hideWhenOff
        sections={game.guideCategories.map((c) => ({ id: c.id, label: c.label }))} guidesHref={`/games/${game.id}/guides/`} />
    )}
    <nav class="after" aria-label="More sections">
      <a class="btn btn-quiet" href={`/games/${game.id}/guides/`}>← Quest board</a>
      {next && <a class="btn btn-primary" href={`/games/${game.id}/guides/${next.id}/`}>Next: {next.label} →</a>}
    </nav>
    <CozmcInline text="Know something we're missing? Tell the community." />
  </div>
</Base>
<style>
  .crumbs { font-size: 14px; color: var(--vc-muted); padding-top: 22px; }
  .lead { max-width: 70ch; margin: 0 0 24px; }
  .after { display: flex; gap: 12px; flex-wrap: wrap; justify-content: space-between; margin: 28px 0; }
</style>
