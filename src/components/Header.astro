---
import { BRAND, COZMC, PARENT_SITE_URL, SITE_NAME } from '../config';
import { mapData, publicObjectives } from '../lib/content/load';
interface Props { current?: string; gameId: string }
const { current, gameId } = Astro.props;
// Guide links follow the game the page belongs to (or the primary game on site-wide pages), so no title is hard-coded here.
const g = `/games/${gameId}`;
const nav = [
  { href: '/games/', label: 'Games', key: 'games' },
  { href: `${g}/guides/`, label: 'Guides', key: 'guides' },
  ...(mapData(gameId) ? [{ href: `${g}/map/`, label: 'Map', key: 'map' }] : []),
  // Shown once a verified achievement list exists (the page itself stays reachable from the game page).
  ...(publicObjectives(gameId).length ? [{ href: `${g}/achievements/`, label: 'Achievements', key: 'achievements' }] : []),
  { href: '/progress/', label: 'My Progress', key: 'progress' },
  { href: '/updates/', label: 'Updates', key: 'updates' },
];
---
<header class="hdr">
  <div class="wrap row">
    <a class="brand" href="/games/" aria-label={`${SITE_NAME}, games list`}>
      <img src={BRAND.mark.src} srcset={`${BRAND.mark.src} 1x, ${BRAND.mark.src2x} 2x`} alt="" width="40" height="40" />
      <span>Nerdy Birdie <small>Gaming Guides</small></span>
    </a>
    <nav class="nav" aria-label="Main">
      {nav.map((n) => <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <div class="right">
      <a class="search" href="/search/">
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        <span class="lbl">Search guides</span>
      </a>
      {COZMC.discord && (
        <a class="cz-pill" href={COZMC.discord} target="_blank" rel="noopener"><i aria-hidden="true"></i>COZMC Discord<span class="sr-only"> (opens in a new tab)</span></a>
      )}
      <details class="menu">
        <summary>Menu</summary>
        <div class="sheet">
          <nav aria-label="Mobile">
            {nav.map((n) => <a href={n.href} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
            <a href="/search/">Search</a>
            {PARENT_SITE_URL && <a href={PARENT_SITE_URL}>NerdyBirdie LLC home</a>}
          </nav>
          <div class="cozmc m-cz">
            <p>COZMC community</p>
            {COZMC.discord ? <a class="cz-btn cz-discord" href={COZMC.discord} target="_blank" rel="noopener">Join the COZMC Discord ↗</a>
              : <span class="cz-btn cz-unavailable">Discord invite coming soon</span>}
            <a class="cz-btn cz-site" href={COZMC.site} target="_blank" rel="noopener">Explore COZMC.US ↗</a>
          </div>
        </div>
      </details>
    </div>
  </div>
</header>

<style>
  .hdr { position: sticky; top: 0; z-index: 20; background: rgba(5, 7, 22, 0.94); backdrop-filter: blur(8px); border-bottom: 1px solid var(--vc-line); }
  .row { display: flex; align-items: center; gap: 28px; height: 64px; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font: 700 17px/1.1 'Space Grotesk', var(--body); white-space: nowrap; }
  .brand img { width: 40px; height: 40px; border-radius: 8px; }
  /* Holographic name, like the logo's wordmark. */
  .brand > span:not(.sr-only) { background: var(--nb-holo); -webkit-background-clip: text; background-clip: text; color: transparent; -webkit-text-fill-color: transparent; }
  .brand small { display: block; font: 600 11px var(--body); color: var(--vc-muted); -webkit-text-fill-color: var(--vc-muted); letter-spacing: 0.08em; text-transform: uppercase; }
  .nav { display: flex; gap: 4px; }
  .nav a { text-decoration: none; color: var(--vc-muted); font-size: 15px; padding: 8px 10px; border-radius: 8px; }
  .nav a:hover { color: var(--vc-pearl); }
  .nav a[aria-current='page'] { color: var(--vc-pearl); box-shadow: inset 0 -2px 0 var(--vc-pink); border-radius: 0; }
  .right { margin-left: auto; display: flex; align-items: center; gap: 10px; }
  .search { display: flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 14px; border: 1px solid var(--vc-line); border-radius: 10px;
    background: var(--vc-slate); color: var(--vc-muted); font-size: 14px; text-decoration: none; min-width: 190px; }
  .search:hover { color: var(--vc-pearl); }
  /* COZMC's own Discord button (cozmc.us .btn--discord): square, blurple, hard shadow, pixel type. */
  .cz-pill { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border-radius: 0; font: 700 11px/1 var(--cz-pixel);
    letter-spacing: 0.04em; text-transform: uppercase; background: var(--cz-discord); color: #fff; border: 2px solid var(--cz-discord);
    box-shadow: 3px 3px 0 var(--cz-discord-deep); text-decoration: none; white-space: nowrap; transition: transform 0.08s, box-shadow 0.08s; }
  .cz-pill:hover { background: #6b77ff; transform: translate(-1px, -1px); box-shadow: 4px 4px 0 var(--cz-discord-deep); }
  .cz-pill i { width: 8px; height: 8px; background: var(--cz-phos); box-shadow: 0 0 8px var(--cz-phos); }
  .menu { display: none; position: relative; }
  @media (max-width: 1280px) {
    .row { gap: 18px; }
    .search { min-width: 0; padding: 0 12px; }
    .lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
  .menu summary { list-style: none; cursor: pointer; min-height: 44px; display: flex; align-items: center; padding: 0 14px;
    border: 1px solid var(--vc-line); border-radius: 10px; background: var(--vc-slate); font-weight: 600; font-size: 15px; }
  .menu summary::-webkit-details-marker { display: none; }
  .menu[open] summary { border-color: var(--vc-pink); }
  .sheet { position: fixed; left: 0; right: 0; top: 56px; background: var(--nb-black); border-bottom: 1px solid var(--vc-line);
    padding: 12px var(--gutter) 20px; max-height: calc(100dvh - 56px); overflow-y: auto; }
  .sheet nav { display: flex; flex-direction: column; }
  .sheet nav a { padding: 14px 4px; border-bottom: 1px solid var(--vc-line); text-decoration: none; font-size: 17px; font-weight: 600; }
  .sheet nav a[aria-current='page'] { color: var(--vc-pink); }
  .m-cz { margin-top: 16px; display: flex; flex-direction: column; gap: 10px; background: var(--cz-bg-1); border: 1px solid var(--cz-line); border-radius: 0; padding: 16px; }
  .m-cz p { margin: 0; font: 700 11px var(--cz-pixel); letter-spacing: 0.05em; text-transform: uppercase; color: var(--cz-phos); }
  @media (max-width: 960px) {
    .row { height: 56px; gap: 12px; }
    .nav, .cz-pill { display: none; }
    .lbl { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .search { min-width: 0; padding: 0 12px; }
    .menu { display: block; }
    .brand img { width: 34px; height: 34px; }
  }
</style>
