---
import CommunityLinks from './CommunityLinks.astro';
import { BRAND } from '../config';
interface Props { text?: string }
const { text = 'Stuck on one? Ask the community.' } = Astro.props;
---
<aside class="cozmc cz-inline" aria-label="COZMC community">
  <p class="lead-in"><img src={BRAND.cozmcMascotFist} alt="" width="40" height="40" loading="lazy" decoding="async" /><span><strong>COZMC</strong> · {text}</span></p>
  <div class="links"><CommunityLinks size="compact" discordLabel="Join the Discord" siteLabel="cozmc.us" /></div>
</aside>

<style>
  .cz-inline { position: relative; display: flex; gap: 16px; align-items: center; justify-content: space-between; flex-wrap: wrap;
    background: var(--cz-bg-1); border: 1px solid var(--cz-line); padding: 16px 20px; }
  .cz-inline::before { content: ''; position: absolute; left: -1px; top: -1px; width: 12px; height: 12px;
    border-left: 2px solid var(--cz-phos); border-top: 2px solid var(--cz-phos); }
  p { margin: 0; color: var(--cz-mist); }
  .lead-in { display: flex; align-items: center; gap: 12px; }
  .lead-in img { width: 40px; height: 40px; flex: none; }
  strong { color: var(--cz-phos); font: 700 13px var(--cz-pixel); letter-spacing: 0.04em; }
  .links { display: flex; gap: 12px 18px; flex-wrap: wrap; }
  .links :global(.cz-btn) { min-height: 44px; padding: 0 14px; font-size: 12px; }
</style>
