---
import CommunityLinks from './CommunityLinks.astro';
/** Home-page community module, in COZMC's own purple/coral identity. */
---
<section class="cozmc cz-panel" aria-labelledby="cozmc-heading">
  <div class="cz-copy">
    <img src="/brand/cozmc/cozmc-logo-272.png" alt="COZMC" width="136" height="36" loading="lazy" decoding="async" />
    <p class="cz-k">We Are All COZMC</p>
    <h2 id="cozmc-heading">Play together. Build together.</h2>
    <p class="cz-p">Connect with fellow gamers, share discoveries and grow with our community.</p>
  </div>
  <div class="cz-ctas"><CommunityLinks /></div>
</section>

<style>
  .cz-panel {
    position: relative; overflow: hidden; border-radius: 18px; padding: 40px;
    background:
      radial-gradient(1200px 400px at 85% -20%, rgba(145, 118, 222, 0.32), transparent 60%),
      radial-gradient(600px 300px at 0% 120%, rgba(255, 111, 97, 0.2), transparent 60%),
      var(--cz-space);
    border: 1px solid var(--cz-line);
    display: grid; grid-template-columns: 1.4fr 1fr; gap: 28px; align-items: center;
  }
  .cz-panel::after {
    content: ''; position: absolute; inset: 0; pointer-events: none; opacity: 0.7;
    background-image: radial-gradient(1px 1px at 20% 30%, #fff, transparent), radial-gradient(1px 1px at 70% 62%, #fff, transparent),
      radial-gradient(1.5px 1.5px at 42% 82%, #fff, transparent), radial-gradient(1px 1px at 90% 18%, #fff, transparent),
      radial-gradient(1px 1px at 8% 76%, #fff, transparent);
  }
  .cz-copy img { display: block; height: 28px; width: auto; margin-bottom: 18px; }
  .cz-k { margin: 0; font: 700 12px var(--body); letter-spacing: 0.14em; text-transform: uppercase; color: var(--cz-coral); }
  h2 { font-size: clamp(24px, 3vw, 30px); margin: 8px 0; }
  .cz-p { color: var(--cz-soft); margin: 0; max-width: 46ch; }
  .cz-ctas { display: flex; flex-direction: column; gap: 12px; position: relative; z-index: 1; }
  @media (max-width: 960px) { .cz-panel { grid-template-columns: 1fr; padding: 28px 22px; } }
</style>
