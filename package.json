{
  "name": "nerdybirdie-gaming",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run && node --test tests/feed/*.test.mjs",
    "e2e": "npm run build && npm run build:test && playwright test --trace off",
    "verify": "npm run check && npm test && npm run e2e",
    "build:test": "NBG_FIXTURES=1 astro build",
    "import:map": "node scripts/import-map.mjs",
    "demo:ask": "vitest run tests/demo/ask-demo.test.ts",
    "pull:approved": "node scripts/pull-approved.mjs",
    "test:feed": "node --test tests/feed/*.test.mjs",
    "feed:recover": "node scripts/feed-recover.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.7.0",
    "@astrojs/preact": "6.1.6",
    "@astrojs/sitemap": "3.7.6",
    "@fontsource-variable/saira": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/pixelify-sans": "5.3.0",
    "@fontsource/press-start-2p": "5.3.0",
    "@fontsource/silkscreen": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "@netlify/blobs": "11.1.9",
    "@supabase/supabase-js": "2.119.0",
    "astro": "7.4.13",
    "leaflet": "1.9.4",
    "preact": "11.2.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@netlify/functions": "6.1.1",
    "@playwright/test": "1.63.0",
    "@types/leaflet": "1.9.20",
    "@types/node": "22.20.5",
    "playwright-core": "1.63.0",
    "typescript": "6.0.3",
    "vitest": "5.1.1"
  }
}
